{
  "name": "risk-feature-policy",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/risk/feature-policy/src",
  "projectType": "library",
  "prefix": "pnc",
  "tags": ["scope:risk", "type:feature"],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "ng-js/tsconfig.spec.json",
        "buildTarget": "risk-console:build:development",
        "include": ["../../../../ng-js/libs/risk/feature-policy/src/**/*.spec.ts"],
        "runner": "vitest",
        "coverage": true,
        "coverageReporters": ["text-summary", "lcov"]
      },
      "dependsOn": [
        {
          "projects": ["risk-console"],
          "target": "ng-prep"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
        "cwd": "libs/risk/feature-policy"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
